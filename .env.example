# ---------------------------------------------------------------------------
# Variables d'environnement. Copier les valeurs utiles dans .env.local en local
# et dans les variables d'environnement Vercel en production.
# Les variables sans préfixe NEXT_PUBLIC_ restent côté serveur uniquement.
# ---------------------------------------------------------------------------

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://lechroniqueur.com

# Lecture des métadonnées d'inscription (serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=

# Notifications par email — Resend (serveur uniquement)
RESEND_API_KEY=
EMAIL_FROM="lechroniqueur <notification@lechroniqueur.com>"

# Notifications WhatsApp — Meta Cloud API (serveur uniquement)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
